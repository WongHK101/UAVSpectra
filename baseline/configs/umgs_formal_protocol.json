{
  "schema": "umgs_anonymous_formal_protocol_v1",
  "method": "UMGS",
  "bands": [
    "G",
    "R",
    "RE",
    "NIR"
  ],
  "input": {
    "sensor_layout": "one RGB camera plus four distinct multispectral cameras",
    "dynamic_range": "uint16",
    "radiometric_mode": "exposure_normalized",
    "rgb_camera_model": "SIMPLE_RADIAL",
    "rgb_resolution_factor": 8,
    "band_resolution_factor": 8,
    "reported_rgb_sfm_protocol": "all_images_then_frozen_registered_camera_split",
    "reported_cli_selector": "--raw_sfm_protocol all_images",
    "prospective_cli_default_not_used_for_archived_results": "--raw_sfm_protocol train_only_register_test",
    "split_policy": "frozen scene-specific split; registered LLFF hold-8 for Benchmark16"
  },
  "rgb_anchor": {
    "iterations": 30000,
    "sh_degree": 3,
    "position_lr_init": 0.00016,
    "position_lr_final": 1.6e-06,
    "position_lr_delay_mult": 0.01,
    "position_lr_max_steps": 30000,
    "feature_lr": 0.0025,
    "opacity_lr": 0.025,
    "scaling_lr": 0.005,
    "rotation_lr": 0.001,
    "exposure_lr_init": 0.01,
    "exposure_lr_final": 0.001,
    "percent_dense": 0.01,
    "lambda_dssim": 0.2,
    "densify_from_iter": 500,
    "densify_until_iter": 15000,
    "densification_interval": 100,
    "opacity_reset_interval": 3000,
    "densify_grad_threshold": 0.0002
  },
  "cross_sensor_conditioning": {
    "backend": "MINIMA",
    "matcher": "RoMa large",
    "minima_repository_revision": "796e7721174f9f829b79b3702bf8c2ae9a3d447a",
    "minima_checkpoint_filename": "weights/minima_roma.pth",
    "minima_checkpoint_sha256": "17f3923bd780e8f1450792706e0643f70c8864ad11bf5fd4f2b54714bac23538",
    "applied_transform": "quality-weighted robust aggregate of accepted framewise homographies",
    "metadata_h0_role": "diagnostic only",
    "estimation_frames": 12,
    "qa_frames": 6,
    "edge_dilate_radius": 1,
    "qa_alignment_scale": 0.25,
    "qa_alignment_max_dim": 640,
    "qa_fail_fast": true,
    "min_improved_ratio": 0.6,
    "max_severe_outliers": 0,
    "high_modality_bands": [
      "NIR"
    ],
    "warning_min_accepted_ratio": 0.8,
    "warning_min_delta_edge_f1": -0.05,
    "warning_min_gradient_improved_ratio": 0.6,
    "warning_max_severe_outlier_ratio": 0.1,
    "warning_max_severe_outlier_count": 1,
    "stability_grid": 5,
    "stability_warning_mean_px": 25.0,
    "stability_max_reject_ratio": 0.25,
    "minima_match_threshold": 0.3,
    "minima_fine_threshold": 0.1,
    "minima_match_max_dim": 1600,
    "minima_confidence_threshold": 0.2,
    "minima_min_matches": 80,
    "minima_min_inlier_ratio": 0.3,
    "minima_max_reprojection_error_px": 4.0,
    "minima_min_coverage": 0.25,
    "minima_coverage_grid": 4,
    "ransac": "USAC_MAGSAC",
    "ransac_threshold_px": 3.0,
    "ransac_confidence": 0.999,
    "ransac_max_iterations": 10000,
    "initial_candidate_ratio": 0.15,
    "candidate_ratio_step": 0.15,
    "max_candidate_ratio": 0.5,
    "use_all_if_needed": true,
    "full_sequence_if_frames_at_most": 300,
    "residual_refinement_enabled": false
  },
  "spectral_transfer": {
    "restore_checkpoint_iteration": 30000,
    "final_global_iteration": 60000,
    "new_updates_per_band": 30000,
    "stage2_mode": "band_transfer",
    "reset_appearance_features": true,
    "freeze_position": true,
    "freeze_scaling": true,
    "freeze_rotation": true,
    "freeze_opacity": true,
    "preserve_gaussian_count_and_order": true,
    "disable_densification_pruning_and_opacity_reset": true,
    "tied_scalar_carrier": true,
    "single_band_replicate_to_rgb": true,
    "feature_lr": 0.001,
    "opacity_lr": 0.0,
    "lambda_dssim": 0.0,
    "use_rectification_validity_mask": true,
    "require_rectified_band_scene": true
  },
  "products": {
    "indices": {
      "NDVI": "(NIR-R)/(NIR+R+eps)",
      "GNDVI": "(NIR-G)/(NIR+G+eps)",
      "NDRE": "(NIR-RE)/(NIR+RE+eps)"
    },
    "eps": 1e-06,
    "evaluation_mask": "common valid intersection"
  },
  "randomness": {
    "python_random_seed": 0,
    "numpy_seed": 0,
    "torch_seed": 0,
    "cuda_device": 0
  },
  "support_acceptance": {
    "required": true,
    "count_equal": true,
    "order_equal": true,
    "position_max_delta": 0.0,
    "scale_max_delta": 0.0,
    "rotation_max_delta": 0.0,
    "opacity_max_delta": 0.0
  }
}
